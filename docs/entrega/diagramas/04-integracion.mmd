flowchart LR
    ERP["ERP del comercio"] -->|"REST síncrono<br/>POST /api/v1/pedidos-externos"| API["PedidosExternosResource"]
    CLI["Cliente final"] -->|"REST síncrono<br/>GET /api/v1/seguimiento/{codigo}"| SEGR["SeguimientoResource"]
    API --> PED["Pedidos"]
    SEGR --> PED
    PED -.->|"asíncrono · cola<br/>cola.pedidos.externos"| LST["PedidoExternoListener"]
    LST --> PED
    PED -.->|"asíncrono · tópico<br/>topico.pedidos.estado"| PAG["Pagos (selector)"]
    PED -.-> NOT["Notificaciones (comercio)"]
    PED -.-> DEST["Notificaciones (destinatario)"]
    PAG -->|"SOAP síncrono<br/>autorizarPago · reversarPago"| BANCO["Banco legado"]
    PED --> TR["Transportistas"]
    TR -->|"SOAP síncrono"| TL["Transportista legado"]
    TR -->|"REST síncrono"| TM["Transportista moderno"]
    NOT -->|"SMTP"| MAIL["Servidor de correo"]
    DEST -->|"SMTP"| MAIL
    RUT["Ruteo"] -->|"HTTP/JSON"| NOM["Nominatim (OSM)"]
    LOGIN["Login de WildFly"] -->|"datos (jdbc-realm)"| DB[("tabla usuarios")]
