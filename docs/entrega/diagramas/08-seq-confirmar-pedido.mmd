sequenceDiagram
    actor Op as Operador
    participant PB as PedidoBean
    participant PS as PedidoService (REQUIRED)
    participant RS as RepartidorService
    participant PG as PagoService
    participant BC as BancoClient + CircuitBreaker
    participant BL as Banco legado (SOAP)
    participant RB as ReversasBancarias
    participant TOPI as topico.pedidos.estado
    Op->>PB: Confirmar
    PB->>PS: confirmarPedido(id)
    PS->>PS: buscarPedidoParaActualizar (PESSIMISTIC_WRITE)
    PS->>RS: motivoParaEsperar(peso, bultos, excluido)
    alt sin lugar o pasó el corte
        RS-->>PS: motivo
        PS->>PS: ponerEnEspera (sin cobro)
        PS-->>PB: null (en espera)
    else hay lugar
        PS->>PG: registrarCobro(PREPAGO)
        PG->>BC: autorizar(PEDIDO-id, importe)
        BC->>BL: autorizarPago (timeout 5 s)
        BL-->>BC: codigoAutorizacion
        PG->>PG: fire PagoAutorizado
        PS->>RS: asignarRepartidor (bloquearCandidatos)
        alt SinLugarException
            RS-->>PS: excepción (rollback)
            Note over RB: AFTER_FAILURE de PagoAutorizado
            RB->>BC: reversar(codigo)
            PS-->>PB: "Probá de nuevo en un momento"
        else asignado
            PS->>PS: cambiarEstado(CONFIRMADO) + fire EstadoPedidoCambiado
            Note over PS,TOPI: commit · AFTER_SUCCESS publica
            PS-)TOPI: {idPedido, estado: CONFIRMADO}
            PS-->>PB: idRepartidor
        end
    end
