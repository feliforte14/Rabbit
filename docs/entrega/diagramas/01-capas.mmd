flowchart TB
    subgraph PRES["Capa de presentación"]
        JSF["Páginas JSF (.xhtml)<br/>*Bean @Named @ViewScoped/@RequestScoped"]
        REST["JAX-RS<br/>PedidosExternosResource · SeguimientoResource"]
        SRV["Servlets<br/>RemitoServlet · FotoVisitaServlet"]
    end
    subgraph NEG["Capa de negocio (EJB)"]
        SLSB["@Stateless<br/>PedidoService · PagoService · RepartidorService · RuteoService ..."]
        SFSB["@Stateful<br/>InventarioService (IReservaStock)"]
        SING["@Singleton<br/>CircuitBreakerBanco · timers"]
        MDB["@MessageDriven<br/>PedidoExternoListener · 3 suscriptores del tópico"]
    end
    subgraph DAT["Capa de datos"]
        REPO["*Repository @ApplicationScoped<br/>EntityManager (comerciosPU)"]
        ENT["Entidades JPA (*/datos/model)"]
    end
    DTO["dto/ (transversal)"]
    INT["integracion/<br/>BancoClient · Adaptadores de transportistas"]
    DB[("PostgreSQL<br/>RabbitDS")]
    JSF --> SLSB
    JSF --> SFSB
    REST --> SLSB
    SRV --> SLSB
    SLSB --> REPO
    SFSB --> REPO
    MDB --> SLSB
    SING --> SLSB
    SLSB --> INT
    REPO --> ENT
    REPO --> DB
    PRES -.-> DTO
    NEG -.-> DTO
