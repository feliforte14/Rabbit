<?xml version="1.0" encoding="UTF-8"?>
<!--
    Le dice al servidor que todo lo que termine en .xhtml debe pasar por
    el FacesServlet (el motor de JSF), y que la pagina de inicio de la
    app es login.xhtml — la primera pantalla que ve cualquiera al entrar,
    sin importar el rol. Tras autenticarse, LoginBean.login() manda a la
    pantalla de inicio de cada tipo de usuario (SesionBean.getPaginaInicio).
    Las paginas estan ordenadas por tipo de usuario: personal/, comercio/ y
    repartidor/; la plantilla comun vive en WEB-INF/plantillas/, donde el
    navegador no la puede pedir directo. Cada pagina controla el acceso con
    su f:viewAction (SesionBean.exigirPersonal, exigirComercio, ...).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        PROJECT_STAGE=Production: en Development JSF muestra stack traces y
        detalles internos cuando algo falla, informacion util para un
        atacante. El CSS no queda cacheado viejo porque se sirve desde una
        carpeta versionada (resources/rabbit/1_7/): al cambiarlo se sube la
        version. Para depurar en local se puede volver a Development.
    -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!--
        Errores sin detalles internos: el usuario ve una pagina generica y
        el detalle queda solo en el log del servidor. Una vista vencida
        (sesion expirada) vuelve al login.
    -->
    <error-page>
        <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
        <location>/login.xhtml</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.html</location>
    </error-page>

    <!--
        La cookie de sesion solo viaja por HTTPS (secure) y JavaScript no la
        puede leer (http-only): asi no se puede robar la sesion escuchando la
        red ni con un script inyectado.
    -->
    <session-config>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
        </cookie-config>
        <!--
            La sesion viaja SOLO en la cookie, nunca en la URL
            (";jsessionid=..."): una URL con la sesion se puede filtrar al
            copiarla, en el historial o en el encabezado Referer.
        -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>login.xhtml</welcome-file>
    </welcome-file-list>

    <!--
        API REST para el ERP de los comercios (ver PedidosExternosResource):
        solo usuarios con rol ERP, autenticados por HTTP Basic contra el
        ApplicationRealm. Afecta unicamente a /api/v1/pedidos-externos: las
        pantallas JSF siguen usando login.xhtml (LoginBean hace
        request.login) y /api/v1/seguimiento es publica a proposito.
        El usuario del ERP lo crea un administrador desde la app
        (personal/usuarios.xhtml, tipo "ERP"), asociado al comercio al que
        representa: un usuario ERP creado a mano con add-user.sh no tiene
        comercio y la API le responde 403.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>API del ERP</web-resource-name>
            <url-pattern>/api/v1/pedidos-externos</url-pattern>
            <url-pattern>/api/v1/pedidos-externos/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ERP</role-name>
        </auth-constraint>
        <!-- Mas especifico que "/": hay que repetir la exigencia de HTTPS. -->
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!--
        HTTPS obligatorio para todo lo de Rabbit: las pantallas (el login
        manda la contrasena), la API del ERP (HTTP Basic manda usuario y
        clave en cada pedido) y el seguimiento publico. CONFIDENTIAL hace que
        un pedido por HTTP (8080) se redirija a HTTPS (8443, el
        https-listener de WildFly; en local, con certificado autofirmado).
        "/" es el patron por defecto: cubre todo lo que no tenga una regla
        mas especifica.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Rabbit por HTTPS</web-resource-name>
            <url-pattern>/</url-pattern>
        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>CONFIDENTIAL</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!--
        Excepcion: los sistemas de OTRAS empresas que se simulan en este
        mismo WAR (el banco legado SOAP y los dos transportistas). No son
        parte de Rabbit, y Rabbit los llama por HTTP como a cualquier sistema
        externo configurado asi (rabbit.banco.wsdl, endpoint de cada
        transportista). Sin esta regla, la redireccion a HTTPS romperia esas
        llamadas.
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Sistemas externos simulados</web-resource-name>
            <url-pattern>/api/simulador/*</url-pattern>
            <url-pattern>/BancoLegadoService</url-pattern>
            <url-pattern>/TransportistaLegadoService</url-pattern>
        </web-resource-collection>
        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>ApplicationRealm</realm-name>
    </login-config>

    <security-role>
        <role-name>ERP</role-name>
    </security-role>

</web-app>
