<?xml version="1.0" encoding="UTF-8"?>
<!--
    Le dice al servidor que todo lo que termine en .xhtml debe pasar por
    el FacesServlet (el motor de JSF), y que la pagina de inicio de la
    app es login.xhtml — la primera pantalla que ve cualquiera al entrar,
    sin importar el rol. Tras autenticarse, LoginBean.login() manda a
    comercios.xhtml, que sí requiere sesión iniciada (ver SesionBean.exigirSesion).
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        PROJECT_STAGE=Production: en Development JSF muestra stack traces y
        detalles internos cuando algo falla, informacion util para un
        atacante. El CSS no queda cacheado viejo porque se sirve desde una
        carpeta versionada (resources/rabbit/1_4/): al cambiarlo se sube la
        version. Para depurar en local se puede volver a Development.
    -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Production</param-value>
    </context-param>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!--
        Errores sin detalles internos: el usuario ve una pagina generica y
        el detalle queda solo en el log del servidor. Una vista vencida
        (sesion expirada) vuelve al login.
    -->
    <error-page>
        <exception-type>jakarta.faces.application.ViewExpiredException</exception-type>
        <location>/login.xhtml</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.html</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>login.xhtml</welcome-file>
    </welcome-file-list>

    <!--
        API REST para el ERP de los comercios (ver PedidosExternosResource):
        solo usuarios con rol ERP, autenticados por HTTP Basic contra el
        ApplicationRealm. Afecta unicamente a /api/pedidos-externos: las
        pantallas JSF siguen usando login.xhtml (LoginBean hace
        request.login) y /api/seguimiento es publica a proposito.
        El usuario del ERP se crea en WildFly, no desde la app:
          add-user.sh -a -u <usuario> -p '<clave>' -g ERP
    -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>API del ERP</web-resource-name>
            <url-pattern>/api/pedidos-externos</url-pattern>
            <url-pattern>/api/pedidos-externos/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ERP</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>ApplicationRealm</realm-name>
    </login-config>

    <security-role>
        <role-name>ERP</role-name>
    </security-role>

</web-app>
