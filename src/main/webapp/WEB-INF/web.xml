<?xml version="1.0" encoding="UTF-8"?>
<!--
    Le dice al servidor que todo lo que termine en .xhtml debe pasar por
    el FacesServlet (el motor de JSF), y que la pagina de inicio de la
    app es comercios.xhtml.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!--
        PROJECT_STAGE=Development le dice a JSF que estamos desarrollando.
        Efecto principal para nosotros: los recursos de /resources (el CSS)
        se sirven con Cache-Control: no-cache, asi que el navegador los
        vuelve a pedir en cada carga. Sin esto, al cambiar estilos.css hay
        que hacer hard reload a mano en cada maquina — el WAR trae el CSS
        nuevo pero el navegador sigue mostrando el viejo.

        Ademas muestra errores de JSF con mas detalle y avisa si quedan
        FacesMessages sin renderizar.

        Para la entrega/demo final conviene cambiarlo a Production.
    -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>comercios.xhtml</welcome-file>
    </welcome-file-list>

</web-app>
