# Copiá este archivo a .env (que no se sube al repo) y reemplazá cada <...>.
# Con un marcador sin reemplazar, la semilla no arranca.

# Base PostgreSQL local del compose
DB_NAME=rabbit
DB_USER=rabbit
DB_PASSWORD=<contraseña-de-la-base-local>

# Primer administrador de Rabbit (lo crea el contenedor "semilla")
ADMIN_USER=admin
ADMIN_PASSWORD=<contraseña-del-primer-administrador>

# Cuentas demo (demo.operador, demo.erp, demo.erp2, demo.comercio, demo.comercio2,
# demo.repartidor), todas con esta contraseña. Vacío = no se crean.
DEMO_PASSWORD=

# Hora de corte de la hoja de ruta: "ninguno" para demos, o HH:mm (README, paso 7b)
RABBIT_HORA_CORTE=ninguno
