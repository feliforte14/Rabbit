# =====================================================================
# Configuración local de Rabbit para "docker compose up".
#
#   cp .env.example .env
#
# y en .env reemplazá cada <marcador> por un valor tuyo. El .env no se sube
# al repo (.gitignore). Si falta una variable, queda un <marcador> o una
# contraseña tiene menos de 8 caracteres, "docker compose up" corta al
# principio con un mensaje que dice cuál corregir.
# =====================================================================

# Nombre de la base PostgreSQL local que crea el compose. Podés dejarlo.
DB_NAME=rabbit

# Usuario dueño de esa base, con el que se conecta WildFly. Podés dejarlo.
DB_USER=rabbit

# Contraseña de ese usuario de la base (mínimo 8 caracteres). Inventala:
# es solo para esta base local.
DB_PASSWORD=<contraseña-de-la-base-local>

# Usuario del primer administrador de Rabbit (lo crea la semilla). Con él
# entrás a https://localhost:8443/Rabbit. Podés dejarlo.
ADMIN_USER=admin

# Contraseña de ese administrador (mínimo 8 caracteres).
ADMIN_PASSWORD=<contraseña-del-primer-administrador>

# Contraseña de las cuentas de prueba (mínimo 8 caracteres), la misma para
# todas: demo.operador, demo.erp, demo.erp2, demo.comercio, demo.comercio2 y
# demo.repartidor.
DEMO_PASSWORD=<contraseña-de-las-cuentas-demo>

# Hora de corte de la hoja de ruta de los repartidores: "ninguno" (sin
# corte, para demos y pruebas) o una hora HH:mm, por ejemplo 07:00.
RABBIT_HORA_CORTE=ninguno
